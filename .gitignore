# Local data and evaluator/reference material
data/raw/*
!data/raw/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.route

# Generated outputs and logs
logs/
results/*
!results/.gitkeep
experiments/*
!experiments/.gitkeep
*.log
*.tmp
*.temp

# Model artifacts are local until an explicit distribution policy is agreed
models/*.joblib
models/*.pkl
models/random_forest_v1/*
!models/random_forest_v1/.gitkeep

# Python environments, bytecode, and test/tool caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and operating-system temporary files
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store
